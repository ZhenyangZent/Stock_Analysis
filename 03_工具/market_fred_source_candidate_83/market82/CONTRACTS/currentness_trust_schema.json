{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stock-analysis:market-source-semantics:v3",
  "title": "Market Source Semantics Receipt Candidate",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "receipt_id",
    "receipt_kind",
    "synthetic",
    "run_cutoff",
    "scope",
    "identity",
    "source_receipt_refs",
    "indicators"
  ],
  "properties": {
    "schema_version": {"const": "MARKET_SOURCE_SEMANTICS_3.0.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "receipt_kind": {"const": "MARKET_ONLY"},
    "synthetic": {"const": true},
    "run_cutoff": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "required": ["dependency_domains", "t46_document_ledger_required"],
      "properties": {
        "dependency_domains": {"type": "array", "items": {"type": "string"}},
        "t46_document_ledger_required": {"const": false}
      }
    },
    "identity": {
      "type": "object",
      "required": ["input_market72_zip_sha256", "rules_sha256"],
      "properties": {
        "input_market72_zip_sha256": {"$ref": "#/$defs/sha256"},
        "rules_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_receipt_refs": {
      "type": "array",
      "minItems": 7,
      "items": {"$ref": "#/$defs/sourceReceiptRef"}
    },
    "indicators": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/indicator"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceReceiptRef": {
      "allOf": [
        {"$ref": "#/$defs/artifactRef"},
        {
          "type": "object",
          "required": ["source_id"],
          "properties": {
            "source_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "scheduleReceiptRef": {
      "allOf": [
        {"$ref": "#/$defs/artifactRef"},
        {
          "type": "object",
          "required": ["schedule_receipt_id"],
          "properties": {
            "schedule_receipt_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "required": [
        "observation_key",
        "observation_date",
        "calendar_key",
        "source_id",
        "source_receipt_id",
        "schedule_receipt_id",
        "source_payload_sha256",
        "schedule_payload_sha256",
        "source_published_at",
        "available_at",
        "fetched_at",
        "vintage_policy",
        "value"
        ,"unit"
      ],
      "properties": {
        "observation_key": {"type": "string", "minLength": 1},
        "observation_date": {"type": "string", "format": "date"},
        "calendar_key": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "source_id": {"type": "string", "minLength": 1},
        "source_receipt_id": {"type": "string", "minLength": 1},
        "schedule_receipt_id": {"type": "string", "minLength": 1},
        "source_payload_sha256": {"$ref": "#/$defs/sha256"},
        "schedule_payload_sha256": {"$ref": "#/$defs/sha256"},
        "source_published_at": {"type": "string", "format": "date-time"},
        "available_at": {"type": "string", "format": "date-time"},
        "fetched_at": {"type": "string", "format": "date-time"},
        "vintage_policy": {"enum": ["N/A", "REVISED", "ALFRED_INITIAL"]}
        ,"unit": {"type": "string", "minLength": 1}
      }
    },
    "indicator": {
      "type": "object",
      "required": [
        "indicator_id",
        "source_id",
        "latest_expected_period",
        "latest_observed_period",
        "missing_expected_periods",
        "schedule_receipt_ref",
        "observations"
      ],
      "properties": {
        "indicator_id": {"enum": ["M1", "M2", "M3", "M4", "M5", "M6", "M7"]},
        "source_id": {"type": "string", "minLength": 1},
        "latest_expected_period": {"type": "string", "minLength": 1},
        "latest_observed_period": {"type": "string", "minLength": 1},
        "missing_expected_periods": {"type": "array", "items": {"type": "string"}},
        "schedule_receipt_ref": {"$ref": "#/$defs/scheduleReceiptRef"},
        "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}
      }
    }
  }
}
